# Database
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/acolhe

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# SUAP OAuth
SUAP_CLIENT_ID=your-suap-client-id
SUAP_CLIENT_SECRET=your-suap-client-secret
SUAP_REDIRECT_URI=http://localhost:8000/auth/suap/callback
SUAP_BASE_URL=https://suap.ifrn.edu.br

# Security
SECRET_KEY=your-secret-key-change-in-production
# LEGACY_SECRET_KEYS=old-key-1,old-key-2  # comma-separated old keys for password hash migration

# App
DEBUG=false
DEV_MODE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
